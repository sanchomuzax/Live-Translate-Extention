{
  "manifest_version": 2,
  "name": "Live Translate Mobile",
  "version": "1.6.4",
  "description": "Experimental live translation for HTML5 audio and video in a mobile browser.",
  "homepage_url": "https://github.com/sanchomuzax/Live-Translate-Extention",
  "permissions": [
    "activeTab",
    "storage",
    "https://generativelanguage.googleapis.com/*"
  ],
  "browser_action": {
    "default_title": "Start / stop Live Translate"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "pcm-worklet.js"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com",
  "browser_specific_settings": {
    "gecko": {
      "id": "live-translate-mobile-unlisted-7b2c4d8e@sanchomuzax.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent",
          "personalCommunications"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
